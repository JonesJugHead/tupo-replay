{
  "name": "tupo-replay",
  "version": "0.1.0",
  "private": true,
  "author": "JonesJugHead",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:dev": "node build.mjs --dev",
    "lint": "web-ext lint --source-dir dist --self-hosted",
    "package": "node build.mjs && web-ext build --source-dir dist --overwrite-dest",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "e2e": "node build.mjs --e2e && node e2e/firefox-e2e.mjs && node build.mjs",
    "store": "node e2e/store-icon.mjs && node build.mjs --e2e && THEME=light node e2e/firefox-e2e.mjs && THEME=dark node e2e/firefox-e2e.mjs && node build.mjs"
  },
  "packageManager": "pnpm@11.20.0",
  "dependencies": {
    "gifenc": "^1.0.3"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "web-ext": "^8.10.0",
    "ws": "^8.22.0"
  }
}
